# Configuración del Servidor
PORT=8080
NODE_ENV=development

# Base de datos (en producción Fly.io usa /data/database.json)
DB_FILE=./database.json

# Usuario Administrador
ADMIN_USERNAME=danigarmo
ADMIN_PASSWORD_HASH=

# Claves de Seguridad (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
SESSION_SECRET=

# SMTP para envío de correos (opcional - usa App Password de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gardanie73@gmail.com
SMTP_PASS=

# Google OAuth 2.0 (crear proyecto en Google Cloud Console)
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un proyecto o selecciona uno existente
# 3. APIs y Servicios > Credenciales > Crear Credenciales > ID de cliente OAuth
# 4. Tipo: Aplicación web
# 5. Orígenes JavaScript autorizados: http://localhost:8080, https://cronoestrato-2023.fly.dev
# 6. URIs de redirección autorizados: (dejar vacío para Google Identity Services)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret